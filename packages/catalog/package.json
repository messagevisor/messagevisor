{
  "name": "@messagevisor/catalog",
  "version": "0.3.0",
  "description": "Static catalog UI for Messagevisor projects",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "src",
    "package.json"
  ],
  "scripts": {
    "transpile": "rimraf lib && tsc --project tsconfig.cjs.json",
    "dev": "node scripts/dev.mjs",
    "build": "npm run transpile && vite build",
    "test": "jest --config jest.config.js --verbose",
    "preview": "vite preview --host 127.0.0.1 --port 3000"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "homepage": "https://messagevisor.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/messagevisor/messagevisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/messagevisor/messagevisor/issues"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
