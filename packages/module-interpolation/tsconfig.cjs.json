{
  "extends": "../../tsconfig.cjs.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "es2018",
    "lib": ["es2021", "es2021.intl", "dom"],
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./src/**/*.spec.ts"]
}
