{
  "name": "@messagevisor/react",
  "version": "1.0.0",
  "description": "React package for Messagevisor",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "transpile": "rimraf lib && tsc --project tsconfig.cjs.json",
    "dist": "echo 'Nothing to dist here'",
    "build": "npm run transpile",
    "test": "jest --config jest.config.js --verbose",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "homepage": "https://messagevisor.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/messagevisor/messagevisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/messagevisor/messagevisor/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@messagevisor/types": "1.0.0"
  },
  "peerDependencies": {
    "@messagevisor/sdk": ">=0.26.0 <2",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@messagevisor/sdk": "1.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
