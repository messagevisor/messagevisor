{
  "name": "@messagevisor/sdk",
  "version": "0.26.0",
  "description": "Messagevisor SDK for Node.js and the browser",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "cjs/index.d.ts",
  "files": [
    "cjs",
    "esm",
    "node-esm"
  ],
  "exports": {
    ".": {
      "types": "./cjs/index.d.ts",
      "require": "./cjs/index.js",
      "import": "./node-esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "transpile": "rimraf cjs esm node-esm && tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json && tsc --project tsconfig.node-esm.json && node -e \"require('fs').writeFileSync('node-esm/package.json', '{\\n  \\\"type\\\": \\\"module\\\"\\n}\\n')\"",
    "dist": "echo 'Nothing to dist here'",
    "build": "npm run transpile",
    "test": "jest --config jest.config.js --verbose",
    "test:package": "npm run build && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.typecheck.json"
  },
  "author": {
    "name": "Fahad Heylaal",
    "url": "https://fahad19.com"
  },
  "homepage": "https://messagevisor.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/messagevisor/messagevisor.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/messagevisor/messagevisor/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@messagevisor/types": "0.26.0"
  }
}
